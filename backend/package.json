{
  "name": "quizmaster-backend",
  "version": "1.0.0",
  "description": "QuizMaster Pro Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node -r module-alias/register dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:api": "node scripts/api-test-suite.js",
    "test:api:dev": "API_BASE_URL=http://localhost:3001 node scripts/api-test-suite.js",
    "test:api:prod": "API_BASE_URL=https://api.quizmasterpro.com node scripts/api-test-suite.js",
    "test:api:comprehensive": "node scripts/comprehensive-api-test.js",
    "test:api:comprehensive:dev": "API_BASE_URL=http://localhost:3001 node scripts/comprehensive-api-test.js",
    "test:api:comprehensive:prod": "API_BASE_URL=https://api.quizmasterpro.com node scripts/comprehensive-api-test.js",
    "docs": "node scripts/open-swagger.js",
    "docs:dev": "API_BASE_URL=http://localhost:3001 node scripts/open-swagger.js",
    "api:status": "node scripts/api-status.js",
    "api:status:dev": "API_BASE_URL=http://localhost:3001 node scripts/api-status.js",
    "test:api:complete": "node scripts/complete-api-test-suite.js",
    "test:api:complete:dev": "API_BASE_URL=http://localhost:3001 node scripts/complete-api-test-suite.js",
    "audit:routes": "node scripts/audit-all-routes.js",
    "audit:coverage": "node scripts/coverage-gap-analysis.js"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "keywords": [
    "quiz",
    "multiplayer",
    "real-time",
    "api"
  ],
  "author": "QuizMaster Pro Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@google/generative-ai": "^0.15.0",
    "@huggingface/inference": "^2.8.1",
    "@prisma/client": "^6.15.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "axios": "^1.11.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "prisma": "^6.15.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.4.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
