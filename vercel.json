{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@api_url",
    "NEXT_PUBLIC_WEBSOCKET_URL": "@websocket_url"
  },
  "regions": ["iad1"],
  "functions": {
    "frontend/src/app/api/**": {
      "maxDuration": 30
    }
  }
}
