# Database
DATABASE_URL="postgresql://username:password@localhost:5432/quizmaster"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (Generate secure 256-bit keys for production)
JWT_SECRET="your-super-secure-jwt-secret-key-256-bits-minimum"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-key-256-bits-minimum"

# Server Configuration
NODE_ENV="production"
PORT="3001"
CORS_ORIGIN="https://your-frontend-domain.vercel.app"

# AI Service Configuration
GOOGLE_API_KEY="your-google-api-key"
AI_DEFAULT_MODEL="gemini-1.5-flash"
AI_FALLBACK_MODEL="gemini-1.5-flash"
AI_DAILY_USAGE_LIMIT="100"
AI_MAX_QUESTIONS_PER_BATCH="3"
AI_MIN_QUALITY_SCORE="0.6"
AI_RATE_LIMIT_RPM="50"

# Optional: Other AI Providers
# OPENAI_API_KEY="your-openai-key"
# ANTHROPIC_API_KEY="your-anthropic-key"
# HUGGINGFACE_API_KEY="your-huggingface-key"
